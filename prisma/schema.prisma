generator client {
  provider = "prisma-client-js"
  // output   = "../lib/generated/prisma"
   binaryTargets = ["native"] // add this line
}

datasource db {
  provider = "cockroachdb"
  url      = env("DB2_URL")
}

model User {
  id             String           @id @default(uuid())
  name           String
  email          String           @unique
  emailVerified  Boolean
  image          String?
  createdAt      DateTime
  updatedAt      DateTime
  level          CourseLevel      @default(FIRST_YEAR)
  isAdmin        Boolean          @default(false)
  role           String?
  banned         Boolean?
  banReason      String?
  banExpires     DateTime?
  setup          Boolean          @default(false)
  courses        Course[]
  lessonProgress LessonProgress[]
  nglLinks       NglLink?
  nglMessages    NglMessage[]
  accounts       Account[]
  chat           chat[]
  enrollments    Enrollment[]
  notes          notes[]
  quizzes        Quiz[]
  sessions       Session[]
   quizAttempts QuizAttempt[]
   liveSessions LiveSession[]
   LiveSessionParticipants LiveSessionParticipant[]
   

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime
  updatedAt      DateTime
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model Course {
  id               String       @id @unique @default(uuid())
  title            String
  description      String
  fileKey          String?
  price            Int
  duration         Int
  level            CourseLevel  @default(FIRST_YEAR)
  category         String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  smallDescription String
  slug             String       @unique
  status           CourseStatus @default(DRAFT)
  userId           String
  chapters         Chapter[]
  user             User         @relation(fields: [userId], references: [id])
  enrollments      Enrollment[]
}

model Chapter {
  id        String   @id @default(uuid())
  title     String
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson    Lesson[]
}

model Lesson {
  id           String           @id @default(uuid())
  title        String
  description  String?
  position     Int
  thumbnailKey String?
  videoKey     String?
  chapterId    String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  progress     LessonProgress[]
  chapter      Chapter          @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@map("lesson")
}

model Quiz {
  id          String       @id @unique @default(uuid())
  title       String
  description String
  fileKey     String?
  price       Int
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  slug        String       @unique
  status      CourseStatus @default(DRAFT)
  level       CourseLevel  @default(FIRST_YEAR)
  category    String
  userId      String
  cours       cours[]
  liveSessions LiveSession[]
  enrollments Enrollment[]
   quizAttempts QuizAttempt[]
  user        User         @relation(fields: [userId], references: [id])

  @@map("quiz")
}

model Qcm {
  id             String      @id @default(uuid())
  question       String
  position       Int
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  comment        String?
  examYear       Int?
  parentId       String?
  type           String      @default("QCM")
  typeQuestionId Int         @default(1)
  coursId        String?
  examId         String?
  cours          cours?      @relation(fields: [coursId], references: [id], onDelete: Cascade)
  exams          exams?      @relation(fields: [examId], references: [id], onDelete: Cascade)
  qcm            Qcm?        @relation("qcmToqcm", fields: [parentId], references: [id], onDelete: Cascade)
  other_qcm      Qcm[]       @relation("qcmToqcm")
  answers        QcmAnswer[]

  @@index([parentId])
  @@index([coursId])
  @@map("qcm")
}

model QcmAnswer {
  id        String  @id @default(uuid())
  text      String
  isCorrect Boolean @default(false)
  position  Int
  qcmId     String
  percent   Int     @default(0)
  qcm       Qcm     @relation(fields: [qcmId], references: [id], onDelete: Cascade)

  @@unique([qcmId, position])
  @@index([qcmId])
  @@map("qcm_answer")
}

model Enrollment {
  id            String       @id @default(uuid())
  amount        Int
  status        String       @default("PENDING")
  transactionId String?
  userId        String
  courseId      String?
  quizId        String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  offer         Boolean      @default(false)
  offerLevel    CourseLevel?
  isOffer       Boolean      @default(false)
  course        Course?      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  quiz          Quiz?        @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@unique([userId, quizId])
  @@map("enrollment")
}

model LessonProgress {
  id        String   @id @default(uuid())
  userId    String
  lessonId  String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model cours {
  id        String   @id @default(cuid())
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  quizId    String
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
   quizAttempts QuizAttempt[]
   liveSessions LiveSession[]

  qcm       Qcm[]
}

model notes {
  id          String   @id @default(cuid())
  content     String?
  title       String
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  imageNumber Int      @default(12)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, id])
}

model exams {
  id        String      @id @unique @default(uuid())
  title     String
  createdAt DateTime    @default(now())
  updatedAt DateTime
  category  String
  level     CourseLevel
  quizAttempts QuizAttempt[]
  liveSessions LiveSession[]
  year      Int         @default(0)
  qcm       Qcm[]
}

model books {
  id        String   @id @unique
  title     String
  cover     String?
  url       String
  moduleId  String
  createdAt DateTime @default(now())
  updatedAt DateTime
  modules   modules  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
}

model links {
  id         String    @id @unique
  title      String
  url        String
  resourceId String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime
  resources  resources @relation(fields: [resourceId], references: [id], onDelete: Cascade)
}

model models3d {
  id         String    @id @unique
  title      String
  url        String
  resourceId String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime
  resources  resources @relation(fields: [resourceId], references: [id], onDelete: Cascade)
}

model modules {
  id          String      @id @unique
  title       String
  icon        String?
  description String?
  uniteId     String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime
  level       CourseLevel @default(FIRST_YEAR)
  books       books[]
  unites      unites?     @relation(fields: [uniteId], references: [id], onDelete: Cascade)
  resources   resources[]
}

model pdfs {
  id         String    @id @unique
  title      String
  url        String
  resourceId String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime
  resources  resources @relation(fields: [resourceId], references: [id], onDelete: Cascade)
}

model resources {
  id          String     @id @unique
  title       String
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime
  moduleId    String
  links       links[]
  models3d    models3d[]
  pdfs        pdfs[]
  modules     modules    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  videos      videos[]
}

model unites {
  id          String      @id @unique
  title       String
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime
  level       CourseLevel @default(FIRST_YEAR)
  modules     modules[]
}

model videos {
  id         String    @id @unique
  title      String
  url        String
  resourceId String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime
  resources  resources @relation(fields: [resourceId], references: [id], onDelete: Cascade)
}

model NglLink {
  /// Public share code (used in /ngl/[code])
  code        String   @id
  recipientId String   @unique
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  recipient   User     @relation(fields: [recipientId], references: [id], onDelete: Cascade)
}

model NglMessage {
  id          String   @id @default(cuid())
  recipientId String
  content     String
  userAgent   String?
  ipHash      String?
  createdAt   DateTime @default(now())
  fileKey     String?
  recipient   User     @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt])
}

model chat {
  id          String        @id @default(cuid())
  pdfName     String
  pdfFileKey  String
  userId      String
  createdAt   DateTime      @default(now())
  pdfAnnotations Json? 
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatMessage chatMessage[]
}

model chatMessage {
  id        String   @id
  content   String
  chatId    String
  role      chatRole
  createdAt DateTime @default(now())
  chat      chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
}

model pdf_chunks {
  id          String                @id
  file_key    String
  page_number BigInt
  text        String
  embedding   Unsupported("vector")
  created_at  DateTime              @default(now()) @db.Timestamptz(6)

  @@index([file_key, page_number], map: "pdf_chunks_filekey_page_idx")
}


model QuizAttempt {
  id               String    @id @default(cuid())
  createdAt        DateTime  @default(now())

  // who
  userId           String?  
  user             User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // what this run was based on (all optional — pass whichever you have)
  quizId           String? 
  quiz             Quiz?     @relation(fields: [quizId], references: [id], onDelete: SetNull)

  coursId          String?  
  cours            cours?    @relation(fields: [coursId], references: [id], onDelete: SetNull)

  examId           String?  
  exam             exams?    @relation(fields: [examId], references: [id], onDelete: SetNull)

  // display label (e.g. "Endocrino... 5ÈME MED")
  topic            String

  // timing
  startedAt        DateTime
  endedAt          DateTime
  durationSeconds  Int

  // scoring
  totalQuestions   Int
  attempted        Int
  correctCount     Int
  wrongCount       Int
  scorePercent     Int        // 0..100
  completedAll     Boolean

  // hidden bookkeeping
  qcmIds           String[]   // store Qcm.id and/or subQcm.id
  answers          Json?      // optional raw AnswerLog[] for audits/review

  @@index([userId, createdAt])
  @@index([quizId])
  @@index([coursId])
  @@index([examId])
}

// --- Live session enums ---
enum LiveSessionMode {
  QUIZ
  EXAM
}

enum LiveSessionStatus {
  DRAFT
  LOBBY
  RUNNING
  ENDED
  CANCELLED
}

// --- Live session models ---
model LiveSession {
  id               String             @id @default(cuid())
  code             String             @unique                 // short join code
  mode             LiveSessionMode
  quizId           String?
  coursId          String?
  examId           String?
  hostId           String
  scheduledStart   DateTime?
  durationSec      Int
  allowLateJoin    Boolean            @default(false)
  createdAt        DateTime           @default(now())
  startedAt        DateTime?
  endedAt          DateTime?
  status           LiveSessionStatus  @default(DRAFT)

  // Snapshot of selected questions (ids/order/seed/minimal text)
  questionSnapshot Json

  // Relations
  quiz         Quiz?      @relation(fields: [quizId], references: [id], onDelete: SetNull)
  cours        cours?     @relation(fields: [coursId], references: [id], onDelete: SetNull)
  exam         exams?     @relation(fields: [examId], references: [id], onDelete: SetNull)
  host         User       @relation(fields: [hostId], references: [id], onDelete: Cascade)
  participants LiveSessionParticipant[]

  @@index([status])
  @@index([hostId])
}

model LiveSessionParticipant {
  id           String      @id @default(uuid())
  sessionId    String
  userId       String?     // null for guest
  displayName  String
  joinedAt     DateTime    @default(now())
  finishedAt   DateTime?
  attempted    Int?
  correctCount Int?
  wrongCount   Int?
  scorePercent Int?
  answers      Json?       // AnswerLog[] for corrections

  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([userId])
}



enum CourseLevel {
  FIRST_YEAR
  SECOND_YEAR
  THIRD_YEAR
  FOURTH_YEAR
  FIFTH_YEAR
  SIXTH_YEAR
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum chatRole {
  USER
  SYSTEM
}

