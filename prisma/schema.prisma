generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "cockroachdb"
  url      = env("DB2_URL")
}

model User {
  id             String           @id
  name           String
  email          String           @unique
  emailVerified  Boolean
  image          String?
  createdAt      DateTime
  updatedAt      DateTime
  level          CourseLevel      @default(FIRST_YEAR)
  isAdmin        Boolean          @default(false)
  role           String?
  banned         Boolean?
  banReason      String?
  banExpires     DateTime?
  setup          Boolean          @default(false)
  courses        Course[]
  lessonProgress LessonProgress[]
  accounts       Account[]
  enrollments    Enrollment[]
  notes          notes[]
  quizzes        Quiz[]
  sessions       Session[]
  nglLinks       NglLink[]
  nglMessages    NglMessage[]

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime
  updatedAt      DateTime
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model Course {
  id               String       @id @unique @default(uuid())
  title            String
  description      String
  fileKey          String?
  price            Int
  duration         Int
  level            CourseLevel  @default(FIRST_YEAR)
  category         String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  smallDescription String
  slug             String       @unique
  status           CourseStatus @default(DRAFT)
  userId           String
  chapters         Chapter[]
  user             User         @relation(fields: [userId], references: [id])
  enrollments      Enrollment[]
}

model Chapter {
  id        String   @id @default(uuid())
  title     String
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson    Lesson[]
}

model Lesson {
  id           String           @id @default(uuid())
  title        String
  description  String?
  position     Int
  thumbnailKey String?
  videoKey     String?
  chapterId    String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  progress     LessonProgress[]
  chapter      Chapter          @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@map("lesson")
}

model Quiz {
  id          String       @id @unique @default(uuid())
  title       String
  description String
  fileKey     String?
  price       Int
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  slug        String       @unique
  status      CourseStatus @default(DRAFT)
  level       CourseLevel  @default(FIRST_YEAR)
  category    String
  userId      String
  cours       cours[]
  enrollments Enrollment[]
  user        User         @relation(fields: [userId], references: [id])

  @@map("quiz")
}

model Qcm {
  id             String      @id @default(uuid())
  question       String
  position       Int
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  comment        String?
  examYear       Int?
  parentId       String?
  type           String      @default("QCM")
  typeQuestionId Int         @default(1)
  coursId        String?
  examId         String?
  cours          cours?      @relation(fields: [coursId], references: [id], onDelete: Cascade)
  exams          exams?      @relation(fields: [examId], references: [id], onDelete: Cascade)
  qcm            Qcm?        @relation("qcmToqcm", fields: [parentId], references: [id], onDelete: Cascade)
  other_qcm      Qcm[]       @relation("qcmToqcm")
  answers        QcmAnswer[]

  @@index([parentId])
  @@index([coursId])
  @@map("qcm")
}

model QcmAnswer {
  id        String  @id @default(uuid())
  text      String
  isCorrect Boolean @default(false)
  position  Int
  qcmId     String
  percent   Int     @default(0)
  qcm       Qcm     @relation(fields: [qcmId], references: [id], onDelete: Cascade)

  @@unique([qcmId, position])
  @@index([qcmId])
  @@map("qcm_answer")
}

model Enrollment {
  id            String       @id @default(uuid())
  amount        Int
  status        String       @default("PENDING")
  transactionId String?
  userId        String
  courseId      String?
  quizId        String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  offer         Boolean      @default(false)
  offerLevel    CourseLevel?
  course        Course?      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  quiz          Quiz?        @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  isOffer       Boolean      @default(false)
  @@unique([userId, courseId])
  @@unique([userId, quizId])
  @@map("enrollment")
}

model LessonProgress {
  id        String   @id @default(uuid())
  userId    String
  lessonId  String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model cours {
  id        String   @id @default(cuid())
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  quizId    String
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  qcm       Qcm[]
}

model notes {
  id          String   @id @default(cuid())
  content     String?
  title       String
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  imageNumber Int      @default(12)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, id])
}

model exams {
  id        String      @id @unique @default(uuid())
  title     String
  createdAt DateTime    @default(now())
  updatedAt DateTime
  category  String
  level     CourseLevel
  year      Int         @default(0)
  qcm       Qcm[]
}

model books {
  id        String   @id @unique
  title     String
  cover     String?
  url       String
  moduleId  String
  createdAt DateTime @default(now())
  updatedAt DateTime
  modules   modules  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
}

model links {
  id         String    @id @unique
  title      String
  url        String
  resourceId String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime
  resources  resources @relation(fields: [resourceId], references: [id], onDelete: Cascade)
}

model models3d {
  id         String    @id @unique
  title      String
  url        String
  resourceId String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime
  resources  resources @relation(fields: [resourceId], references: [id], onDelete: Cascade)
}

model modules {
  id          String      @id @unique
  title       String
  icon        String?
  description String?
  uniteId     String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime
  level       CourseLevel @default(FIRST_YEAR)
  books       books[]
  unites      unites?     @relation(fields: [uniteId], references: [id], onDelete: Cascade)
  resources   resources[]
}

model pdfs {
  id         String    @id @unique
  title      String
  url        String
  resourceId String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime
  resources  resources @relation(fields: [resourceId], references: [id], onDelete: Cascade)
}

model resources {
  id          String     @id @unique
  title       String
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime
  moduleId    String
  links       links[]
  models3d    models3d[]
  pdfs        pdfs[]
  modules     modules    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  videos      videos[]
}

model unites {
  id          String      @id @unique
  title       String
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime
  level       CourseLevel @default(FIRST_YEAR)
  modules     modules[]
}

model videos {
  id         String    @id @unique
  title      String
  url        String
  resourceId String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime
  resources  resources @relation(fields: [resourceId], references: [id], onDelete: Cascade)
}

model NglLink {
  /// Public share code (used in /ngl/[code])
  code        String   @id
  recipientId String   @unique
  recipient   User     @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model NglMessage {
  id          String   @id @default(cuid())
  recipientId String
  recipient   User     @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  fileKey    String?
  content     String   
  userAgent   String?
  ipHash      String?
  createdAt   DateTime @default(now())

  @@index([recipientId, createdAt])
}

enum CourseLevel {
  FIRST_YEAR
  SECOND_YEAR
  THIRD_YEAR
  FOURTH_YEAR
  FIFTH_YEAR
  SIXTH_YEAR
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
