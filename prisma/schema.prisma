generator client {
  provider      = "prisma-client-js"
  output        = "../lib/generated/prisma"
  binaryTargets = ["native"]
}

datasource db {
  provider = "cockroachdb"
  url      = env("DB2_URL")
}

model User {
  id                      String                   @id @default(uuid())
  name                    String
  email                   String                   @unique
  emailVerified           Boolean
  image                   String?
  createdAt               DateTime
  updatedAt               DateTime
  level                   CourseLevel              @default(FIRST_YEAR)
  isAdmin                 Boolean                  @default(false)
  role                    String?
  banned                  Boolean?
  banReason               String?
  banExpires              DateTime?
  setup                   Boolean                  @default(false)
  courses                 Course[]
  lessonProgress          LessonProgress[]
  liveSessions            LiveSession[]
  LiveSessionParticipants LiveSessionParticipant[]
  nglLinks                NglLink?
  nglMessages             NglMessage[]
  quizAttempts            QuizAttempt[]
  accounts                Account[]
  chat                    chat[]
  enrollments             Enrollment[]
  notes                   notes[]
  quizzes                 Quiz[]
  sessions                Session[]

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime
  updatedAt      DateTime
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model Course {
  id               String       @id @unique @default(uuid())
  title            String
  description      String
  fileKey          String?
  price            Int
  duration         Int
  level            CourseLevel  @default(FIRST_YEAR)
  category         String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  smallDescription String
  slug             String       @unique
  status           CourseStatus @default(DRAFT)
  userId           String
  chapters         Chapter[]
  user             User         @relation(fields: [userId], references: [id])
  enrollments      Enrollment[]
}

model Chapter {
  id        String   @id @default(uuid())
  title     String
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson    Lesson[]
}

model Lesson {
  id           String           @id @default(uuid())
  title        String
  description  String?
  position     Int
  thumbnailKey String?
  videoKey     String?
  chapterId    String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  progress     LessonProgress[]
  chapter      Chapter          @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  muxVideoId   String?
  @@map("lesson")
}

model Quiz {
  id           String        @id @unique @default(uuid())
  title        String
  isUnite      Boolean       @default(false)
  description  String
  fileKey      String?
  price        Int
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  slug         String        @unique
  status       CourseStatus  @default(DRAFT)
  level        CourseLevel   @default(FIRST_YEAR)
  category     String
  userId       String
  liveSessions LiveSession[]
  quizAttempts QuizAttempt[]
  cours        cours[]
  enrollments  Enrollment[]
  user         User          @relation(fields: [userId], references: [id])
  quizModules  quizmodule[]
  @@map("quiz")
}

model Qcm {
  id             String      @id @default(uuid())
  question       String
  position       Int
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  comment        String?
  examYear       Int?
  parentId       String?
  type           String      @default("QCM")
  typeQuestionId Int         @default(1)
  coursId        String?
  examId         String?
  cours          cours?      @relation(fields: [coursId], references: [id], onDelete: Cascade)
  exams          exams?      @relation(fields: [examId], references: [id], onDelete: Cascade)
  qcm            Qcm?        @relation("qcmToqcm", fields: [parentId], references: [id], onDelete: Cascade)
  other_qcm      Qcm[]       @relation("qcmToqcm")
  answers        QcmAnswer[]

  @@index([parentId])
  @@index([coursId])
  @@map("qcm")
}

model QcmAnswer {
  id        String  @id @default(uuid())
  text      String
  isCorrect Boolean @default(false)
  position  Int
  qcmId     String
  percent   Int     @default(0)
  qcm       Qcm     @relation(fields: [qcmId], references: [id], onDelete: Cascade)

  @@unique([qcmId, position])
  @@index([qcmId])
  @@map("qcm_answer")
}

model Enrollment {
  id            String         @id @default(uuid())
  amount        Int
  status        String         @default("PENDING")
  transactionId String?
  userId        String
  courseId      String?
  quizId        String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  offer         Boolean        @default(false)
  offerLevel    CourseLevel?
  isOffer       Boolean        @default(false)
  ai            Boolean        @default(false)
  billingPeriod BillingPeriod?
  expiresAt     DateTime?
  months        Int?
  paidAt        DateTime?
  course        Course?        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  quiz          Quiz?          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@unique([userId, quizId])
  @@index([transactionId])
  @@map("enrollment")
}

model LessonProgress {
  id        String   @id @default(uuid())
  userId    String
  lessonId  String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}
model quizmodule {
  id        String   @id @default(cuid())
  title     String
  quizId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  cours    cours[]  @relation("QuizModuleCourses")
}

model cours {
  id           String        @id @default(cuid())
  title        String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  quizId       String
  liveSessions LiveSession[]
  quizAttempts QuizAttempt[]
  quiz         Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  qcm          Qcm[]
  quizModuleId String?
  quizmodule   quizmodule?   @relation("QuizModuleCourses", fields: [quizModuleId], references: [id])
}

model notes {
  id          String   @id @default(cuid())
  content     String?
  title       String
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  imageNumber Int      @default(12)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, id])
}

model exams {
  id           String        @id @unique @default(uuid())
  title        String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime
  category     String
  level        CourseLevel
  year         Int           @default(0)
  liveSessions LiveSession[]
  quizAttempts QuizAttempt[]
  qcm          Qcm[]
}

model books {
  id        String   @id @unique
  title     String
  cover     String?
  url       String
  moduleId  String
  createdAt DateTime @default(now())
  updatedAt DateTime
  modules   modules  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
}

model links {
  id         String    @id @unique
  title      String
  url        String
  resourceId String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime
  resources  resources @relation(fields: [resourceId], references: [id], onDelete: Cascade)
}

model models3d {
  id         String    @id @unique
  title      String
  url        String
  resourceId String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime
  resources  resources @relation(fields: [resourceId], references: [id], onDelete: Cascade)
}

model modules {
  id          String      @id @unique
  title       String
  icon        String?
  description String?
  uniteId     String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime
  level       CourseLevel @default(FIRST_YEAR)
  books       books[]
  unites      unites?     @relation(fields: [uniteId], references: [id], onDelete: Cascade)
  resources   resources[]
}

model pdfs {
  id         String    @id @unique
  title      String
  url        String
  resourceId String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime
  resources  resources @relation(fields: [resourceId], references: [id], onDelete: Cascade)
}

model resources {
  id          String       @id @unique
  title       String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime
  moduleId    String
  flashCards  flashCards[]
  links       links[]
  models3d    models3d[]
  pdfs        pdfs[]
  modules     modules      @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  videos      videos[]
}

model unites {
  id          String      @id @unique
  title       String
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime
  level       CourseLevel @default(FIRST_YEAR)
  modules     modules[]
}

model videos {
  id         String    @id @unique
  title      String
  url        String
  resourceId String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime
  resources  resources @relation(fields: [resourceId], references: [id], onDelete: Cascade)
}

model NglLink {
  /// Public share code (used in /ngl/[code])
  code        String   @id
  recipientId String   @unique
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  recipient   User     @relation(fields: [recipientId], references: [id], onDelete: Cascade)
}

model NglMessage {
  id          String   @id @default(cuid())
  recipientId String
  content     String
  userAgent   String?
  ipHash      String?
  createdAt   DateTime @default(now())
  fileKey     String?
  recipient   User     @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt])
}

model chat {
  id             String        @id @default(cuid())
  pdfName        String
  pdfFileKey     String
  userId         String
  createdAt      DateTime      @default(now())
  pdfAnnotations Json?
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatMessage    chatMessage[]
}

model chatMessage {
  id        String   @id
  content   String
  chatId    String
  role      chatRole
  createdAt DateTime @default(now())
  chat      chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
}

model pdf_chunks {
  id          String                @id
  file_key    String
  page_number BigInt
  text        String
  embedding   Unsupported("vector")
  created_at  DateTime              @default(now()) @db.Timestamptz(6)

  @@index([file_key, page_number], map: "pdf_chunks_filekey_page_idx")
}

model QuizAttempt {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  topic           String
  startedAt       DateTime
  endedAt         DateTime
  durationSeconds Int
  totalQuestions  Int
  attempted       Int
  correctCount    Int
  wrongCount      Int
  scorePercent    Int
  completedAll    Boolean
  qcmIds          String[]
  answers         Json?
  userId          String?
  quizId          String?
  coursId         String?
  examId          String?
  cours           cours?   @relation(fields: [coursId], references: [id])
  exam            exams?   @relation(fields: [examId], references: [id])
  quiz            Quiz?    @relation(fields: [quizId], references: [id])
  user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([quizId])
  @@index([coursId])
  @@index([examId])
}

model LiveSession {
  id               String                   @id @default(cuid())
  code             String                   @unique
  mode             LiveSessionMode
  quizId           String?
  coursId          String?
  examId           String?
  hostId           String
  scheduledStart   DateTime?
  durationSec      Int
  allowLateJoin    Boolean                  @default(false)
  createdAt        DateTime                 @default(now())
  startedAt        DateTime?
  endedAt          DateTime?
  status           LiveSessionStatus        @default(DRAFT)
  questionSnapshot Json
  cours            cours?                   @relation(fields: [coursId], references: [id])
  exam             exams?                   @relation(fields: [examId], references: [id])
  host             User                     @relation(fields: [hostId], references: [id], onDelete: Cascade)
  quiz             Quiz?                    @relation(fields: [quizId], references: [id])
  participants     LiveSessionParticipant[]

  @@index([status])
  @@index([hostId])
}

model LiveSessionParticipant {
  id           String      @id @default(uuid())
  sessionId    String
  userId       String?
  displayName  String
  joinedAt     DateTime    @default(now())
  finishedAt   DateTime?
  attempted    Int?
  correctCount Int?
  wrongCount   Int?
  scorePercent Int?
  answers      Json?
  session      LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user         User?       @relation(fields: [userId], references: [id])

  @@index([sessionId])
  @@index([userId])
}

model flashCards {
  id         String     @id @unique
  question   String
  answer     String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime
  resourceId String?
  resources  resources? @relation(fields: [resourceId], references: [id], onDelete: Cascade)
}

enum BillingPeriod {
  MONTHLY
  YEARLY
}

enum LiveSessionMode {
  QUIZ
  EXAM
}

enum LiveSessionStatus {
  DRAFT
  LOBBY
  RUNNING
  ENDED
  CANCELLED
}

enum CourseLevel {
  FIRST_YEAR
  SECOND_YEAR
  THIRD_YEAR
  FOURTH_YEAR
  FIFTH_YEAR
  SIXTH_YEAR
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum chatRole {
  USER
  SYSTEM
}
